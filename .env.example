# =============================================================================
# RAZORPAY TEST MODE KEYS
# =============================================================================
# Get your test mode keys from: https://dashboard.razorpay.com/app/keys
# 
# IMPORTANT: Only test mode keys (rzp_test_*) are allowed
# Production keys (rzp_live_*) are rejected by the backend for safety
#
# Test Payment Cards:
#   Success: 4111 1111 1111 1111
#   Decline: 4222 2222 2222 2222
#
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=rzp_test_YOUR_TEST_KEY_SECRET

# =============================================================================
# GEMINI API KEY
# =============================================================================
# Get your free API key from: https://makersuite.google.com/app/apikey
# Steps:
#   1. Go to https://makersuite.google.com/app/apikey
#   2. Click "Create API Key"
#   3. Copy and paste below
#
GEMINI_API_KEY=paste_your_gemini_api_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite is used for fast local development
# Default: catalog.db (in project root)
# 
# For production, change to PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/dbname
#
DATABASE_URL=sqlite:///./catalog.db

# =============================================================================
# DEBUG MODE
# =============================================================================
# Set to False in production
DEBUG=True
